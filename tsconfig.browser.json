{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "./public/assets",
    "rootDir": "./src",
    "sourceMap": false,
    "target": "ES2022",
    "types": []
  },
  "include": ["src/browser/**/*.ts", "src/thesis/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.e2e.ts"]
}
